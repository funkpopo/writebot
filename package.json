{
  "name": "writebot",
  "version": "1.1.29",
  "description": "Word 智能写作助手",
  "main": "index.js",
  "scripts": {
    "build": "webpack --mode production",
    "prebuild": "node scripts/sync-version.js",
    "build:dev": "webpack --mode development",
    "build:setup": "bun scripts/build-setup-bun.js",
