    "dompurify": "3.4.13",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "socks-proxy-agent": "9.0.0",
    "unified": "11.0.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
